{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kau17033/cam-product-viability-standard",
  "title": "CAM — Product Viability Standard",
  "description": "For items sold but no profit left — 「売れたのに残らない」 — verdicts counting all six cost items.",
  "repository": {
    "url": "https://github.com/kau17033/cam-product-viability-standard",
    "source": "github"
  },
  "version": "1.1.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "cam-verdict",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "cam-verdict-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "cam-verdict",
      "version": "1.1.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "cam-verdict"
        },
        {
          "type": "positional",
          "value": "cam-verdict-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}